# ==============================================================================
# ReproCheck Backend Configuration Template
# Copy this file to .env and adjust values for your local environment.
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
API_PREFIX=/api/v1

# Local Database Connections (PostgreSQL port 5432)
# Async URL used by FastAPI and SQLAlchemy
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/reprocheck
# Synchronous URL used by Alembic migrations
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/reprocheck

# Local Cache Connection (Redis port 6379)
REDIS_URL=redis://localhost:6379/0

# Local File Storage Path (for uploaded PDFs)
UPLOAD_DIR=storage/uploads

# Model Gateway Routing (Active models from Gemini & Groq)
PRIMARY_MODEL=gemini/gemini-3.1-flash-lite
FALLBACK_MODEL=groq/openai/gpt-oss-120b
FAST_CHEAP_MODEL=groq/openai/gpt-oss-20b

# Provider API Keys
GEMINI_API_KEY=
GROQ_API_KEY=

# Langfuse Observability Credentials
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
